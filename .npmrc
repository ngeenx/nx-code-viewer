# @crylith/* installs from GitHub Packages during the pre-stable phase.
# NODE_AUTH_TOKEN must be exported in the shell (or supplied by CI via
# secrets.GITHUB_TOKEN) with the `read:packages` scope. See
# .crylith-link.md for details and tarball fallback for @crylith/live-demos.
@crylith:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
