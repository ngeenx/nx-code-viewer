{
  "name": "svelte-demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/svelte-demo/src",
  "projectType": "application",
  "tags": ["scope:client", "scope:app"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": [
        "nx-base-tailwincss-config:symlink",
        "nx-demo-app-theme:symlink",
        "nx-code-viewer-theme:symlink"
      ],
      "options": {
        "outputPath": "dist/apps/svelte-demo"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "svelte-demo:build",
        "port": 4224
      },
      "configurations": {
        "development": {
          "buildTarget": "svelte-demo:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "svelte-demo:build:production",
          "hmr": false
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "svelte-demo:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "svelte-demo:build:development"
        },
        "production": {
          "buildTarget": "svelte-demo:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "reportsDirectory": "../../coverage/apps/svelte-demo",
        "passWithNoTests": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
