{
  "name": "nx-code-viewer-utils",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client/nx-code-viewer-utils/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/client/nx-code-viewer-utils",
        "main": "packages/client/nx-code-viewer-utils/src/index.ts",
        "tsConfig": "packages/client/nx-code-viewer-utils/tsconfig.lib.json",
        "assets": ["packages/client/nx-code-viewer-utils/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "reportsDirectory": "../../../coverage/packages/client/nx-code-viewer-utils",
        "passWithNoTests": false
      }
    },
    "test-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --ui",
        "cwd": "packages/client/nx-code-viewer-utils"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
