{
  "name": "nx-vue-code-viewer",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client/ui/nx-vue-code-viewer/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "reportsDirectory": "../../../../coverage/packages/client/ui/nx-vue-code-viewer",
        "passWithNoTests": false
      }
    },
    "test-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --ui",
        "cwd": "packages/client/ui/nx-vue-code-viewer"
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4443 --no-open -c packages/client/ui/nx-vue-code-viewer/.storybook"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/packages/client/ui/nx-vue-code-viewer/storybook/nx-vue-code-viewer"
      ],
      "options": {
        "command": "storybook build -c packages/client/ui/nx-vue-code-viewer/.storybook -o dist/packages/client/ui/nx-vue-code-viewer/storybook/nx-vue-code-viewer"
      }
    }
  },
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  }
}
