{
  "name": "nx-react-code-viewer",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client/ui/nx-react-code-viewer/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4445 --no-open -c packages/client/ui/nx-react-code-viewer/.storybook"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/packages/client/ui/nx-react-code-viewer/storybook/nx-react-code-viewer"
      ],
      "options": {
        "command": "storybook build -c packages/client/ui/nx-react-code-viewer/.storybook -o dist/packages/client/ui/nx-react-code-viewer/storybook/nx-react-code-viewer"
      }
    }
  },
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  }
}
