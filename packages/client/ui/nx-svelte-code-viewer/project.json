{
  "name": "nx-svelte-code-viewer",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client/ui/nx-svelte-code-viewer/src",
  "projectType": "library",
  "tags": ["scope:shared", "scope:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/client/ui/nx-svelte-code-viewer"],
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/package.json"],
      "options": {
        "command": "node tools/scripts/copy-source-package.mjs packages/client/ui/nx-svelte-code-viewer dist/packages/client/ui/nx-svelte-code-viewer"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "reportsDirectory": "../../../../coverage/packages/client/ui/nx-svelte-code-viewer",
        "passWithNoTests": false
      }
    },
    "test-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --ui",
        "cwd": "packages/client/ui/nx-svelte-code-viewer"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev -p 4444 --no-open -c packages/client/ui/nx-svelte-code-viewer/.storybook"
      }
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/packages/client/ui/nx-svelte-code-viewer/storybook/nx-svelte-code-viewer"
      ],
      "options": {
        "command": "storybook build -c packages/client/ui/nx-svelte-code-viewer/.storybook -o dist/packages/client/ui/nx-svelte-code-viewer/storybook/nx-svelte-code-viewer"
      }
    }
  }
}
