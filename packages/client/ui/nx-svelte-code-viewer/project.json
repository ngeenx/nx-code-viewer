{
  "name": "nx-svelte-code-viewer",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/client/ui/nx-svelte-code-viewer/src",
  "projectType": "library",
  "tags": ["scope:shared", "scope:ui"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/client/ui/nx-svelte-code-viewer"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "reportsDirectory": "../../../../coverage/packages/client/ui/nx-svelte-code-viewer",
        "passWithNoTests": false
      }
    },
    "test-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest --ui",
        "cwd": "packages/client/ui/nx-svelte-code-viewer"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
